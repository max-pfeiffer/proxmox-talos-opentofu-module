machine:
  features:
    hostDNS:
      # Cilium's bpf.masquerade breaks DNS forwarding to the host, see
      # https://docs.siderolabs.com/kubernetes-guides/cni/deploying-cilium
      forwardKubeDNSToHost: false
  install:
    disk: ${install_disk}
    image: ${install_image}
  network:
    nameservers:
%{ for dns in dns_servers ~}
      - ${dns}
%{ endfor ~}
    interfaces:
      - deviceSelector:
          physical: true
        addresses:
          - ${ip_address}
        routes:
          - network: 0.0.0.0/0
            gateway: ${network_gateway}
        vip:
          ip: ${vip_shared_ip}
cluster:
  allowSchedulingOnControlPlanes: ${allow_scheduling_on_control_planes}
  network:
    cni:
      name: none
  proxy:
    disabled: true
%{ if length(extra_manifests) > 0 ~}
  extraManifests:
%{ for url in extra_manifests ~}
    - ${url}
%{ endfor ~}
%{ endif ~}
  inlineManifests:
%{ for manifest in inline_manifests ~}
    - name: ${manifest.name}
      contents: |
        ${indent(8, manifest.contents)}
%{ endfor ~}
