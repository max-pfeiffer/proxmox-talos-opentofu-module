{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Installed Talos Linux version: Image Factory ISO and installer images, ISO filename and docs. talos_version is the machine configuration contract and is deliberately not matched.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/",
        "/(^|/)README\\.md$/"
      ],
      "matchStrings": [
        "factory\\.talos\\.dev/[^\\s\"]*?[0-9a-f]{64}[/:]v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "talos-linux-v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "talos_installed_version\\s*=\\s*\"v(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Talos Linux v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Kubernetes version in the examples and docs",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)examples/.+\\.tf$/",
        "/(^|/)README\\.md$/"
      ],
      "matchStrings": [
        "kubernetes_version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Kubernetes v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "Ready\\s+\\S+\\s+\\S+\\s+v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Cilium Helm chart version: module default and docs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^variables\\.tf$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "variable \"cilium_version\" \\{[^}]*?default\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Cilium v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "cilium\\\\_version \\|[^|]*\\|[^|]*\\| `\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"`"
      ],
      "depNameTemplate": "cilium",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io"
    },
    {
      "description": "Gateway API CRD versions per Cilium minor version downloaded by the control plane nodes: module versions and docs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^helm_templates\\.tf$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "\"\\d+\\.\\d+\"\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "\\|\\s*\\d+\\.\\d+\\s*\\|\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*\\|"
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Tool versions installed in the workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "TFLINT_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "terraform-docs installed with go install in the workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "TERRAFORM_DOCS_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/terraform-docs/terraform-docs",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Changing the module's Talos ISO, Cilium or Gateway API CRD defaults changes existing clusters, which is a breaking change",
      "matchDepNames": [
        "siderolabs/talos",
        "cilium",
        "kubernetes-sigs/gateway-api"
      ],
      "commitMessagePrefix": "feat(deps)!:"
    },
    {
      "description": "Group all Talos version references into one pull request",
      "matchDepNames": [
        "siderolabs/talos"
      ],
      "groupName": "Talos Linux"
    },
    {
      "description": "Group all Gateway API version references into one pull request",
      "matchDepNames": [
        "kubernetes-sigs/gateway-api"
      ],
      "groupName": "Gateway API"
    },
    {
      "description": "Every Cilium minor version supports one Gateway API minor version, bump it together with the Cilium minor version",
      "matchDepNames": [
        "kubernetes-sigs/gateway-api"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Kubernetes minor versions must be supported by the Talos version, upgrade them deliberately",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Kubernetes version only appears in the examples and docs",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "semanticCommitType": "docs"
    },
    {
      "description": "Module provider constraints: only widen them when a release falls outside, raising the minimum is a breaking change",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "versions.tf"
      ],
      "rangeStrategy": "replace",
      "commitMessagePrefix": "feat(deps)!:"
    },
    {
      "description": "Exact provider versions of the examples",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "examples/**"
      ],
      "groupName": "example providers"
    },
    {
      "description": "Development tooling",
      "semanticCommitType": "ci",
      "groupName": "development tooling",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchManagers": [
        "github-actions",
        "pre-commit",
        "pep621"
      ]
    },
    {
      "description": "Linting tools installed in the workflows belong to the development tooling",
      "matchDepNames": [
        "terraform-linters/tflint",
        "github.com/terraform-docs/terraform-docs"
      ],
      "semanticCommitType": "ci",
      "groupName": "development tooling",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
